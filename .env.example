# Docker Compose environment variables.
# Copy this file to .env and adjust values for local development.
# This file is consumed by docker-compose.yml at "docker compose up" time.

# MySQL
MYSQL_DATABASE=ai_tools_platform
MYSQL_USER=ai_tools_user
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_PORT=3306

# Nginx (host-exposed entrypoint port)
APP_PORT=8080
